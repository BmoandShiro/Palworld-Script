#!/usr/bin/env bash
# Privileged helper for WireGuard on Steam Deck.
# Prefer systemctl (works under Steam Game Mode NO_NEW_PRIVS).
# Fallback: direct wg-quick when already root / via legacy sudo.
set -euo pipefail

CONF_CANDIDATES=(
  "${PALWORLD_WG_CONF:-}"
  /home/deck/.config/palworld-wg.conf
  /etc/palworld-wg.conf
)

WG_INTERFACE="wg0"
WG_QUICK="${WG_QUICK:-/usr/bin/wg-quick}"
SYSTEMCTL="${SYSTEMCTL:-/usr/bin/systemctl}"
IP_BIN="${IP_BIN:-/usr/sbin/ip}"
[[ -x "$IP_BIN" ]] || IP_BIN="/bin/ip"
[[ -x "$IP_BIN" ]] || IP_BIN="$(command -v ip || true)"

for conf in "${CONF_CANDIDATES[@]}"; do
  [[ -n "$conf" && -f "$conf" ]] || continue
  # shellcheck disable=SC1090
  source "$conf"
  break
done

UNIT="wg-quick@${WG_INTERFACE}.service"

usage() {
  echo "usage: $0 up|down|status" >&2
  exit 2
}

[[ $# -eq 1 ]] || usage

iface_up() {
  [[ -n "$IP_BIN" ]] && "$IP_BIN" link show "$WG_INTERFACE" >/dev/null 2>&1
}

do_up() {
  if iface_up; then
    echo "already up: $WG_INTERFACE"
    return 0
  fi

  # systemctl talks to PID 1 over D-Bus — not blocked by Steam NO_NEW_PRIVS.
  if [[ -x "$SYSTEMCTL" ]] && "$SYSTEMCTL" start "$UNIT"; then
    return 0
  fi

  # Fallback when invoked as root (sudo path / manual debug).
  if [[ -x "$WG_QUICK" ]] && [[ "$(id -u)" -eq 0 ]]; then
    "$WG_QUICK" up "$WG_INTERFACE"
    return 0
  fi

  echo "ERROR: failed to start $UNIT (is polkit rule installed?)" >&2
  return 1
}

do_down() {
  if [[ -x "$SYSTEMCTL" ]]; then
    "$SYSTEMCTL" stop "$UNIT" >/dev/null 2>&1 || true
  fi
  if iface_up && [[ "$(id -u)" -eq 0 ]] && [[ -x "$WG_QUICK" ]]; then
    "$WG_QUICK" down "$WG_INTERFACE" || true
  fi
}

do_status() {
  if iface_up; then
    echo "active"
    return 0
  fi
  echo "inactive"
  return 1
}

case "$1" in
  up) do_up ;;
  down) do_down ;;
  status) do_status ;;
  *) usage ;;
esac
