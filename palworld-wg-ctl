#!/usr/bin/env bash
# Control WireGuard for Palworld WITHOUT sudo/polkit.
# Steam Game Mode (and Desktop Steam launches) set NO_NEW_PRIVS, which blocks
# sudo. Polkit may also lack an auth agent under Steam. Instead we touch a
# request file; enabled systemd path units run wg-quick as root.
#
# CTL_VERSION is logged by the launch wrapper — bump when changing behavior.
CTL_VERSION="2026-08-02c"
set -euo pipefail

CONF_CANDIDATES=(
  "${PALWORLD_WG_CONF:-}"
  /home/deck/.config/palworld-wg.conf
  /etc/palworld-wg.conf
)

WG_INTERFACE="wg0"
STATE_DIR="${PALWORLD_WG_STATE:-/home/deck/.local/state/palworld-wg}"
WANT_UP="${STATE_DIR}/want-up"
WANT_DOWN="${STATE_DIR}/want-down"
AGENT_STATUS="${STATE_DIR}/agent-status"
IP_BIN="${IP_BIN:-/usr/sbin/ip}"
[[ -x "$IP_BIN" ]] || IP_BIN="/bin/ip"
[[ -x "$IP_BIN" ]] || IP_BIN="$(command -v ip || true)"
WAIT_SECONDS="${CTL_WAIT_SECONDS:-20}"

for conf in "${CONF_CANDIDATES[@]}"; do
  [[ -n "$conf" && -f "$conf" ]] || continue
  # shellcheck disable=SC1090
  source "$conf"
  break
done

usage() {
  echo "usage: $0 up|down|status|version" >&2
  exit 2
}

[[ $# -eq 1 ]] || usage

if [[ "$1" == "version" ]]; then
  echo "$CTL_VERSION"
  exit 0
fi

# Steam injects a 32-bit overlay via LD_PRELOAD; strip it for host tools.
unset LD_PRELOAD LD_LIBRARY_PATH STEAM_RUNTIME_LIBRARY_PATH || true
export PATH="/usr/sbin:/usr/bin:/sbin:/bin"

mkdir -p "$STATE_DIR"

iface_up() {
  [[ -n "$IP_BIN" ]] && "$IP_BIN" link show "$WG_INTERFACE" >/dev/null 2>&1
}

wait_iface() {
  local want="$1" # up|down
  local deadline=$((SECONDS + WAIT_SECONDS))
  while (( SECONDS < deadline )); do
    if [[ "$want" == up ]] && iface_up; then
      return 0
    fi
    if [[ "$want" == down ]] && ! iface_up; then
      return 0
    fi
    # Surface agent progress while waiting
    if [[ -f "$AGENT_STATUS" ]]; then
      :
    fi
    sleep 0.25
  done
  return 1
}

request() {
  local flag="$1"
  # Retrigger PathExists: remove then create (no systemctl — Steam may hang on polkit).
  rm -f "$flag"
  sync || true
  sleep 0.1
  # Create via rename so the path unit reliably sees a create event
  : >"${flag}.tmp"
  mv -f "${flag}.tmp" "$flag"
  sync || true
}

do_up() {
  echo "ctl-version=$CTL_VERSION"

  if iface_up; then
    echo "already up: $WG_INTERFACE"
    echo up >"$AGENT_STATUS"
    return 0
  fi

  # Never test -f /etc/wireguard/... as user deck: dir is often mode 700.
  echo "requesting-up via $WANT_UP"
  rm -f "$WANT_DOWN"
  echo "pending-up" >"$AGENT_STATUS"
  request "$WANT_UP"

  if wait_iface up; then
    echo "started $WG_INTERFACE"
    echo up >"$AGENT_STATUS"
    return 0
  fi

  echo "ERROR: timed out waiting for $WG_INTERFACE after want-up" >&2
  echo "HINT: systemctl status palworld-wg-up.path palworld-wg-up.service --no-pager" >&2
  echo "HINT: journalctl -u palworld-wg-up.service -n 40 --no-pager" >&2
  if [[ -f "$AGENT_STATUS" ]]; then
    echo "agent-status=$(cat "$AGENT_STATUS")" >&2
  fi
  if [[ -f "$WANT_UP" ]]; then
    echo "HINT: want-up still present — path unit may not have fired" >&2
  fi
  return 1
}

do_down() {
  echo "ctl-version=$CTL_VERSION"

  if ! iface_up; then
    echo "already down: $WG_INTERFACE"
    echo down >"$AGENT_STATUS"
    rm -f "$WANT_UP" "$WANT_DOWN"
    return 0
  fi

  echo "requesting-down via $WANT_DOWN"
  rm -f "$WANT_UP"
  echo "pending-down" >"$AGENT_STATUS"
  request "$WANT_DOWN"

  if wait_iface down; then
    echo "stopped $WG_INTERFACE"
    echo down >"$AGENT_STATUS"
    return 0
  fi

  echo "ERROR: timed out waiting for $WG_INTERFACE to go down" >&2
  return 1
}

do_status() {
  if iface_up; then
    echo "active"
    return 0
  fi
  echo "inactive"
  return 1
}

case "$1" in
  up) do_up ;;
  down) do_down ;;
  status) do_status ;;
  *) usage ;;
esac
