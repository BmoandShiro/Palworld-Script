#!/usr/bin/env bash
# Privileged helper: bring WireGuard up/down via wg-quick.
# Installed on the Deck as /home/deck/bin/palworld-wg-ctl (root-owned).
# Invoked via passwordless sudo from palworld-wg.sh (including Game Mode).
#
# Expects /etc/wireguard/<WG_INTERFACE>.conf (default: wg0).
set -euo pipefail

CONF_CANDIDATES=(
  "${PALWORLD_WG_CONF:-}"
  /home/deck/.config/palworld-wg.conf
  /etc/palworld-wg.conf
)

WG_INTERFACE="wg0"
WG_QUICK="${WG_QUICK:-/usr/bin/wg-quick}"
IP_BIN="${IP_BIN:-/usr/sbin/ip}"
[[ -x "$IP_BIN" ]] || IP_BIN="/bin/ip"
[[ -x "$IP_BIN" ]] || IP_BIN="$(command -v ip || true)"

for conf in "${CONF_CANDIDATES[@]}"; do
  [[ -n "$conf" && -f "$conf" ]] || continue
  # shellcheck disable=SC1090
  source "$conf"
  break
done

usage() {
  echo "usage: $0 up|down|status" >&2
  exit 2
}

[[ $# -eq 1 ]] || usage

if [[ ! -x "$WG_QUICK" ]]; then
  echo "ERROR: wg-quick not found at $WG_QUICK" >&2
  exit 127
fi

iface_up() {
  "$IP_BIN" link show "$WG_INTERFACE" >/dev/null 2>&1
}

case "$1" in
  up)
    if iface_up; then
      echo "already up: $WG_INTERFACE"
      exit 0
    fi
    "$WG_QUICK" up "$WG_INTERFACE"
    ;;
  down)
    if iface_up; then
      "$WG_QUICK" down "$WG_INTERFACE" || true
    fi
    ;;
  status)
    if iface_up; then
      echo "active"
      exit 0
    fi
    echo "inactive"
    exit 1
    ;;
  *)
    usage
    ;;
esac
